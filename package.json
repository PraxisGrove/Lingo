{
  "name": "lingo-translation",
  "description": "Open-source bilingual webpage translation extension.",
  "license": "AGPL-3.0-only",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "locales": "node scripts/generate-browser-locales.mjs",
    "browser:install": "playwright install chromium firefox",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm locales && wxt build",
    "build:firefox": "pnpm locales && wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:extension": "vitest run --config vitest.extension.config.ts",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "check": "biome check .",
    "commitlint": "commitlint",
    "verify:commit": "pnpm lint && pnpm test && pnpm test:browser && pnpm compile && pnpm check && pnpm build && pnpm build:firefox && pnpm test:extension && git diff --check",
    "ship": "bash scripts/ship.sh",
    "prepare": "lefthook install",
    "postinstall": "wxt prepare",
    "brand:preview": "node scripts/preview-brand.mjs"
  },
  "dependencies": {
    "@wxt-dev/storage": "^1.3.0",
    "i18next": "^26.3.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "4.1.12",
    "@wxt-dev/module-react": "^1.1.5",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.2.2",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
